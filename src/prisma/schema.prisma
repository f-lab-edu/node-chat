}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model USR {
  USR_UUID            String                @id @unique(map: "UQ_USR_UUID") @db.Char(36)
  USR_NAME            String                @db.VarChar(50)
  USR_EMAIL           String                @unique(map: "UQ_USR_EMAIL") @db.VarChar(254)
  CREATE_AT           DateTime              @default(now()) @db.DateTime(0)
  CHAT_MSG            CHAT_MSG[]
  CHAT_MSG_UNREAD_USR CHAT_MSG_UNREAD_USR[]
  CHAT_ROOM_MEMBER    CHAT_ROOM_MEMBER[]
