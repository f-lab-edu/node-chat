  USR_UUID   String    @db.Char(36)
  USR_IN_AT  DateTime  @default(now()) @db.DateTime(6)
  USR_OUT_AT DateTime? @db.DateTime(6)
  CHAT_ROOM  CHAT_ROOM @relation(fields: [ROOM_UUID], references: [ROOM_UUID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CHAT_ROOM_TO_CHAT_ROOM_MEMBER")
